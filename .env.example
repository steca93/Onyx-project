# Copy to .env.local and fill in as needed. Never commit .env.local.

# --- Data source ---
# "mock" (default if unset): reads src/data/*.ts fixtures, no backend calls.
# "live": reads the real WooCommerce site via WPGraphQL, and the cart/
# checkout flow talks to the WooCommerce Store API through this app's own
# /api/store/** proxy routes. Both variables below must be set together —
# DATA_SOURCE controls server-side data (Server Components, Route Handlers),
# NEXT_PUBLIC_DATA_SOURCE controls the client-side cart store, which runs in
# the browser and can only read NEXT_PUBLIC_-prefixed variables.
DATA_SOURCE=mock
NEXT_PUBLIC_DATA_SOURCE=mock

# --- WordPress/WooCommerce backend ---
# Base URL only, no trailing slash and no /graphql or /wp-json suffix —
# src/lib/repo/live/client.ts appends those. Falls back to the known
# Cloudways URL if unset, so this only needs to be set to point at a
# different environment (staging, a future production domain, etc).
WP_API_URL=https://woocommerce-1614143-6633101.cloudwaysapps.com

# --- WooCommerce REST API (wc/v3) — admin-side only ---
# Only needed for the one-off product-seeding script (scripts/seed-products.ts,
# not built yet — Phase 9c). Never used by the storefront itself; the
# storefront reads via WPGraphQL and writes carts/orders via the public
# Store API, neither of which need these. Generate under wp-admin →
# WooCommerce → Settings → Advanced → REST API → Add key (Read/Write).
# WC_CONSUMER_KEY=
# WC_CONSUMER_SECRET=
