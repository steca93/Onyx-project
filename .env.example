# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# --- Data source ---
# "mock" (default if unset): reads src/data/*.ts fixtures, no backend calls.
# "live": reads the real WooCommerce site via WPGraphQL, and the cart/
# checkout flow talks to the WooCommerce Store API through this app's own
# /api/store/** proxy. Both must be set together — DATA_SOURCE controls
# server-side data, NEXT_PUBLIC_DATA_SOURCE the browser-side cart store.
DATA_SOURCE=live
NEXT_PUBLIC_DATA_SOURCE=live

# --- WordPress / WooCommerce backend (server-only) ---
# Base URL only — no trailing slash, no /graphql or /wp-json suffix
# (/graphql and /wp-json/wc/store/v1 are derived from it). Required when
# DATA_SOURCE=live; there is deliberately no hardcoded fallback.
# Today: the Cloudways URL. Later: https://cms.onyx.com (env change only).
WORDPRESS_API_URL=https://woocommerce-1614143-6633101.cloudwaysapps.com

# --- Public storefront URL ---
# Used for canonical URLs, hreflang, Open Graph, sitemap and robots.txt.
# Production: https://onyx.com · Preview: the preview URL · Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- On-demand revalidation (server-only) ---
# Shared secret for POST /api/revalidate. Must match ONYX_REVALIDATE_SECRET
# in WordPress's wp-config.php (see wp-backend/README.md).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Indexing ---
# Search engines may index the site only when this resolves to true.
# Unset: indexable only when VERCEL_ENV=production (i.e. the production
# deployment); local and preview deployments get noindex + Disallow: /.
# Set "true"/"false" to force it (e.g. for the SEO test suite).
# SITE_INDEXABLE=

# --- WooCommerce REST API (wc/v3) — admin-side only, not used by the storefront ---
# WC_CONSUMER_KEY=
# WC_CONSUMER_SECRET=
